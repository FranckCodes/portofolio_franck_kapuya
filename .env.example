# Contact form: messages are sent through your Gmail account
GMAIL_USER=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
CONTACT_TO=recipient@example.com

# Notes:
# - `GMAIL_APP_PASSWORD` is an app password, not your Gmail password.
#   Create it at https://myaccount.google.com/apppasswords (2-step verification required).
# - `CONTACT_TO` is optional: messages go to `GMAIL_USER` when it is not set.
